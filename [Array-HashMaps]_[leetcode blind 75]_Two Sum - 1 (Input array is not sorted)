class Solution:
    def twoSum(self, nums: List[int], target: int) -> List[int]:
        if len(nums) == 2:
            return [0, 1]
        nums_with_index = [(n, idx) for idx, n in enumerate(nums)]
        nums_with_index.sort()
        l,r = 0, len(nums)-1
        while l < r:
            s = nums_with_index[l][0] + nums_with_index[r][0]
            if s == target:
                return sorted([nums_with_index[l][1], nums_with_index[r][1]])
                
            elif s > target:
                r -= 1
            else:
                l += 1

