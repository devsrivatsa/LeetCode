twoSum(nums, target) {
    let numsAndIdx = new Array();
    for (let i=0; i<nums.length; i++) {
        numsAndIdx.push([nums[i], i])
    }
    numsAndIdx = numsAndIdx.sort((a, b) => a[0] - b[0]);
    console.log(numsAndIdx);
    let l=0;
    let r=nums.length-1;
    while (l < r) {
        let s = numsAndIdx[l][0] + numsAndIdx[r][0];
        if (s === target) {
            return [numsAndIdx[l][1], numsAndIdx[r][1]];
        }
        else if (s > target) r--;
        else l++;
    }
}

