############ JS prefix postfix ###############

Logic: 
- arr[i] in prefix array is the product of all items except itself before i
- arr[i] in postfix array is the product of all items except itself after i

productExceptSelf(nums) {
    const n = nums.length;
    const res = new Array(n);
    const pref = new Array(n);
    const postf = new Array(n);

    pref[0] = 1;
    postf[n-1] = 1;

    for (let i=1; i<n; i++) pref[i] = nums[i-1] * pref[i-1]; // -> pref[i] is product of all previous numbers in array except itself 
    for (let i=n-2; i>=0; i--) postf[i] = nums[i+1]*postf[i+1];// -> postf[i] is product of all subsequent numbers in array except itself
    for (let i=0; i<n; i++) res[i] = pref[i]*postf[i]; //-> res[i] is therefore product of all items before and after it except itself = pref[i]*postf[i]

    return res
}

TC: O(n)
sc: O(n) * 3 for prefix postfix and result arrays

############ Python prefix postfix Optimized ###############

class Solution:
    def productExceptSelf(self, nums: List[int]) -> List[int]:
        res = [1 for i in range(len(nums))]
        for i in range(1, len(nums)):
            res[i] = nums[i-1] * res[i-1] #prefix array - res[i] = product of all items before i
        
        postf = 1
        for i in range(len(nums)-1, -1, -1):
            res[i] *= postf
            postf *= nums[i]
        
        return res

TC: O(n)
SC: O(n)

############ Go prefix postfix Optimized ###############

func productExceptSelf(nums []int) []int {
    //create arr and fill it with 1
    res := make([]int, len(nums))
    for i := range nums { 
        res[i] = 1
    }
    //calculate prefix
    for i:=1; i<len(nums); i++ {
        res[i] = res[i-1] * nums[i-1]
    }
    postfix := 1
    //multiply prefix values in res with postfix values
    for i := len(nums)-1; i>=0; i-- {
        res[i] = postfix * res[i]
        postfix = postfix * nums[i] 
    }
    return res
}

TC: O(n)
SC: O(n)
