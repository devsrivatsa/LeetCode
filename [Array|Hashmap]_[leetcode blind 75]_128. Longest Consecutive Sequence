class Solution:
    def longestConsecutive(self, nums: List[int]) -> int:
        longest = 0
        mySet = set(nums)
        if len(mySet)==1:
            return 1
        for num in mySet:
            if (num-1) not in mySet:
                length = 1
                while (num + length) in mySet:
                    length += 1
                longest = max(longest, length)
        
        return longest

############################### JS Solution ######################################
function longestConsecutive(nums: number[]): number {
    let longest = 0;
    let mySet = new Set(nums);
    for (let n of mySet) {
        if (!mySet.has(n-1)) {
            let length = 1;
            while (mySet.has(n+length)) { 
                length += 1;    
            }
            longest = Math.max(longest, length)
        }
    }
    return longest
};

############################### Go Solution ######################################
func longestConsecutive(nums []int) int {
    longest := 0
    set := make(map[int]int)
    for _,v := range nums {
        set[v] = v
    }
    for _,n := range set {
        if _,isPresent := set[n-1]; !isPresent {
            length := 1
            for {
                if _, ok := set[n + length]; ok {
                    length += 1
                } else {
                    break
                }
            }
            if longest < length {
                longest = length
            }
        } 
    }
    return longest
}
